# ==============================
# 大模型配置 (推荐 DeepSeek，性价比极高且中文极佳)
# ==============================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ==============================
# 微信推送配置 (三选一即可)
# ==============================
# 渠道 1: PushPlus 推送加 (推荐，微信扫码关注即可获得 Token: https://www.pushplus.plus/)
PUSHPLUS_TOKEN=

# 渠道 2: 方糖 Server酱 (Turbo版: https://sct.ftqq.com/)
SERVERCHAN_KEY=

# 渠道 3: 企业微信机器人 Webhook Key
WECHAT_WORK_KEY=

# ==============================
# 个性化定制
# ==============================
# 简报称呼
RECIPIENT_NAME=嘉贤

# 关注技术领域偏好
USER_INTERESTS=AI Agent、游戏开发/Unity、音色克隆与多模态、代码辅助工具与架构、开源工具生态

# 榜单周期: weekly (默认), daily, monthly
TRENDING_SINCE=weekly

# 过滤编程语言 (留空为全部，如 python, rust, typescript, go)
TRENDING_LANGUAGE=
